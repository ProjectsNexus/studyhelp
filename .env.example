# GEMINI_API_KEY: Primary AI provider key for Google Gemini
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OPENROUTER_API_KEY: Automatic cloud fallback provider key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# AI Provider Orchestration
AI_PRIMARY_PROVIDER=gemini
AI_ENABLE_FALLBACK=true

# Retries, Timeout & Rate-Limit Cooldown
AI_MAX_RETRIES_PER_PROVIDER=1
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_COOLDOWN_SECONDS=60

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=
